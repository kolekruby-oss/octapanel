local function setEnabled(name: string, on: boolean)
	if enabled[name] == on then
		return
	end
	-- Fly dan Swim saling eksklusif
	if on then
		if name == "Fly" and enabled.Swim then
			enabled.Swim = false
			features.Swim(false)
		elseif name == "Swim" and enabled.Fly then
			enabled.Fly = false
			features.Fly(false)
		end
	end
	enabled[name] = on
	features[name](on)
	refreshUI()
end

