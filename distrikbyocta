local function stopEmote(message: string?)
	if emote.conn then
		emote.conn:Disconnect()
		emote.conn = nil
	end
	if emote.track then
		pcall(function() emote.track:Stop(0.2) end)
		emote.track = nil
	end
	emote.index = nil
	refreshEmoteButtons()
	if message then
		emoteStatus.Text = message
	end
end

local function playEmote(i: number)
	if emote.index == i then
		stopEmote("Emote dihentikan.")
		return
	end
	stopEmote()
	local data = EMOTES[i]
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not (data and hum and hum.Health > 0) then
		emoteStatus.Text = "Karakter belum siap."
		return
	end
	if hum.RigType ~= Enum.HumanoidRigType.R6 then
		emoteStatus.Text = "Emote ini khusus R6, karaktermu bukan R6."
		return
	end
	local animator = hum:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = hum
	end
	local anim = Instance.new("Animation")
	anim.AnimationId = "rbxassetid://" .. data.id
	local ok, track = pcall(function() return animator:LoadAnimation(anim) end)
	if not ok or not track then
		emoteStatus.Text = "Gagal memuat emote: " .. data.name
		return
	end
	track.Priority = Enum.AnimationPriority.Action4
	track.Looped = true
	track:Play(0.2)
	emote.track, emote.index = track, i
	refreshEmoteButtons()
	emoteStatus.Text = "Memutar: " .. data.name .. " (klik lagi atau STOP untuk berhenti)"

	-- animasi yang tidak bisa dimuat (asset tidak boleh dipakai di game ini) panjangnya 0
	task.delay(1.5, function()
		if emote.track == track and track.Length <= 0 then
			stopEmote("Animasi tidak bisa dimuat. Cek izin asset " .. data.id .. " untuk game ini.")
		end
	end)

	-- emote tetap jalan saat karakter bergerak / lompat; berhenti hanya kalau mati atau respawn
	emote.conn = RunService.Heartbeat:Connect(function()
		if emote.track ~= track then return end
		if not hum.Parent or hum.Health <= 0 then
			stopEmote("Emote dihentikan.")
			return
		end

	end)
end

