---------------------------------------------------------------------
local NV_FOLDERS = { "Stalker", "Pembunuh", "Hidden", "Abysswalker", "Veil", "Slasher", "Masked", "Cure", "!General", "Butcher" }
local NV_GREEN = Color3.fromRGB(60, 255, 90)
local NV_RED = Color3.fromRGB(255, 50, 50)
local nv = { on = false, line = true, distance = true, name = true, custom = true, body = true }
local nvEntries = {} -- [model] = { highlight, billboard, label, line }
local nvLastScan = 0

local R6_PARTS = { "Head", "Torso", "Left Arm", "Right Arm", "Left Leg", "Right Leg", "HumanoidRootPart" }
local R15_PARTS = { "Head", "UpperTorso", "LowerTorso", "LeftUpperArm", "RightUpperArm", "LeftUpperLeg", "RightUpperLeg", "HumanoidRootPart" }

local nvFolder = Instance.new("Folder")
nvFolder.Name = "NightVisionObjects"
