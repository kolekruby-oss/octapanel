nvGui.IgnoreGuiInset = true
nvGui.DisplayOrder = 5
nvGui.Parent = playerGui
KEEP_VISIBLE_GUIS[nvGui.Name] = true

local function nvIsCustom(model: Model): boolean
	local plr = Players:GetPlayerFromCharacter(model)
	if not plr then
		return true -- model dari game (NPC / rig bawaan game), bukan avatar pemain
	end
	local hum = model:FindFirstChildOfClass("Humanoid")
	if not hum then
		return true
	end
	local list = hum.RigType == Enum.HumanoidRigType.R15 and R15_PARTS or R6_PARTS
	for _, partName in ipairs(list) do
		if not model:FindFirstChild(partName) then
			return true
		end
	end
	return false
end

local function nvAnchor(model: Model): BasePart?
	return model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
end

local function nvRemove(model)
	local e = nvEntries[model]
	if not e then return end
	nvEntries[model] = nil
	e.highlight:Destroy()
	e.billboard:Destroy()
	e.line:Destroy()
end

local function nvAdd(model: Model)
	local anchor = nvAnchor(model)
	if not anchor then return end
	local e = {}
	e.highlight = Instance.new("Highlight")
	e.highlight.Adornee = model
	e.highlight.FillColor = NV_GREEN
	e.highlight.OutlineColor = NV_GREEN
	e.highlight.FillTransparency = 0.45
	e.highlight.OutlineTransparency = 0
	e.highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	e.highlight.Parent = nvFolder
	e.billboard = Instance.new("BillboardGui")
	e.billboard.Adornee = model:FindFirstChild("Head") or anchor
	e.billboard.Size = UDim2.fromOffset(220, 40)
	e.billboard.StudsOffset = Vector3.new(0, 2.6, 0)
	e.billboard.AlwaysOnTop = true
	e.billboard.MaxDistance = math.huge
	e.billboard.Parent = nvFolder
	e.label = Instance.new("TextLabel")
	e.label.Size = UDim2.fromScale(1, 1)
	e.label.BackgroundTransparency = 1
	e.label.Font = Enum.Font.GothamBold
	e.label.TextSize = 14
	e.label.TextColor3 = WHITE
	e.label.TextStrokeTransparency = 0.3
	e.label.Parent = e.billboard
	e.line = Instance.new("Frame")
	e.line.AnchorPoint = Vector2.new(0.5, 0.5)
	e.line.BackgroundColor3 = NV_GREEN
	e.line.BorderSizePixel = 0
	e.line.Visible = false
	e.line.Parent = nvGui
	nvEntries[model] = e
end

local function nvCollect()
	local found = {}
	local myChar = player.Character
	for _, plr in ipairs(Players:GetPlayers()) do
		local ch = plr.Character
		if plr ~= player and ch and ch ~= myChar and ch:FindFirstChildOfClass("Humanoid") then
			found[ch] = true
		end
	end
	for _, folderName in ipairs(NV_FOLDERS) do
		local folder = workspace:FindFirstChild(folderName)
		if folder then
			for _, d in ipairs(folder:GetDescendants()) do
				if d:IsA("Model") and d ~= myChar and (d:FindFirstChildOfClass("Humanoid") or d:FindFirstChild("HumanoidRootPart")) then
					found[d] = true
				end
			end
		end
	end
	return found
end

local function nvScan()
	local found = nvCollect()
	for model in pairs(nvEntries) do
		if not found[model] or not model:IsDescendantOf(workspace) or not nvAnchor(model) then
			nvRemove(model)
		end
	end
	for model in pairs(found) do
		if not nvEntries[model] then
			nvAdd(model)
		end
	end
end

local function nvClear()
	for model in pairs(nvEntries) do
		nvRemove(model)
	end
end

local function nvUpdate()
	local cam = workspace.CurrentCamera
	if not cam then return end
	local view = cam.ViewportSize
	local from = Vector2.new(view.X / 2, view.Y)
	local myChar = player.Character
	local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
	for model, e in pairs(nvEntries) do
		local anchor = nvAnchor(model)
		if not anchor then
			nvRemove(model)
		else
			local dist = myRoot and (anchor.Position - myRoot.Position).Magnitude or (anchor.Position - cam.CFrame.Position).Magnitude
			e.highlight.Enabled = nv.body

			-- rig custom (kalau opsi Nama Custom ON): body + garis + nama jadi merah
			local custom = nvIsCustom(model)
			local tint = (custom and nv.custom) and NV_RED or NV_GREEN
			e.highlight.FillColor = tint
			e.highlight.OutlineColor = tint
			e.line.BackgroundColor3 = tint
			local parts = {}
			if nv.name then
				if custom and nv.custom then
					table.insert(parts, "Custom")
				else
					local plr = Players:GetPlayerFromCharacter(model)
					table.insert(parts, plr and plr.DisplayName or model.Name)
				end
			elseif nv.custom and custom then
				table.insert(parts, "Custom")
			end
			if nv.distance then
				table.insert(parts, string.format("[%dm]", math.floor(dist + 0.5)))
			end
			e.billboard.Enabled = #parts > 0
			e.label.Text = table.concat(parts, " ")
			e.label.TextColor3 = (custom and nv.custom) and NV_RED or WHITE

			-- garis dari bawah tengah layar ke target
			if nv.line then
				local pos, onScreen = cam:WorldToViewportPoint(anchor.Position)
				if onScreen and pos.Z > 0 then
					local to = Vector2.new(pos.X, pos.Y)
					local delta = to - from
					e.line.Size = UDim2.fromOffset(delta.Magnitude, 1.5)
					e.line.Position = UDim2.fromOffset((from.X + to.X) / 2, (from.Y + to.Y) / 2)
					e.line.Rotation = math.deg(math.atan2(delta.Y, delta.X))
					e.line.Visible = true
				else
					e.line.Visible = false
				end
			else
				e.line.Visible = false
			end
		end
	end
end

